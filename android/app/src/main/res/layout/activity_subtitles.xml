<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/ink"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/ink" app:title="@string/subtitles"
        app:titleTextColor="@color/text"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp">
        <TextView android:id="@+id/count"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/hint"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Label" android:paddingTop="2dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSelectAll"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="40dp"
                android:minWidth="0dp" android:textSize="13sp" android:text="@string/select_all" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSelectNone"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="40dp"
                android:minWidth="0dp" android:textSize="13sp" android:text="@string/select_none" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDelete"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="40dp"
                android:minWidth="0dp" android:textSize="13sp" android:textColor="@color/danger"
                android:text="@string/delete_selected" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/genToggle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="14dp" android:textColor="@color/accent" android:textSize="14sp"
        android:text="@string/gen_expand" />

    <LinearLayout android:id="@+id/genBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:visibility="gone">

    <LinearLayout android:id="@+id/cloudBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp" android:layout_marginTop="14dp"
        android:padding="12dp" android:background="@drawable/banner_ok">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/cloud_title" android:textColor="@color/ok"
            android:textSize="13.5sp" android:textStyle="bold" />
        <TextView android:id="@+id/cloudHint"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Label" android:paddingTop="3dp"
            android:lineSpacingMultiplier="1.35" android:text="@string/cloud_hint" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/cloudProgress"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:indeterminate="true"
            android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCloudSetup"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="46dp"
                android:minWidth="0dp" android:textSize="13sp" android:text="@string/cloud_setup" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCloudAudio"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="46dp"
                android:minWidth="0dp" android:textSize="13sp" android:text="@string/cloud_share_audio" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCloudJson"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="46dp"
                android:minWidth="0dp" android:textSize="13sp" android:text="@string/cloud_save_json" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCloudLocales"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="46dp"
                android:minWidth="0dp" android:textSize="13sp" android:text="@string/cloud_locales" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCloud"
                android:layout_width="0dp" android:layout_height="46dp"
                android:layout_weight="1" android:layout_marginStart="6dp"
                android:text="@string/cloud_run" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/asrBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_margin="14dp"
        android:padding="12dp" android:background="@drawable/banner_warn">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/asr_title" android:textColor="@color/accent"
            android:textSize="13.5sp" android:textStyle="bold" />
        <TextView android:id="@+id/asrHint"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Label" android:paddingTop="3dp"
            android:lineSpacingMultiplier="1.35" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/asrProgress"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:max="100" android:progress="0"
            android:visibility="gone" />
        <TextView android:id="@+id/asrStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Label" android:paddingTop="6dp" />
        <ScrollView android:id="@+id/asrLogScroll"
            android:layout_width="match_parent" android:layout_height="150dp"
            android:layout_marginTop="8dp" android:background="@color/ink"
            android:padding="8dp" android:visibility="gone">
            <TextView android:id="@+id/asrLog"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textSize="10.5sp"
                android:textColor="@color/dim" android:lineSpacingMultiplier="1.35"
                android:textIsSelectable="true" />
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAsrCheck"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="46dp"
                android:minWidth="0dp" android:textSize="13sp" android:text="@string/asr_check" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAsrWav"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="46dp"
                android:minWidth="0dp" android:textSize="13sp" android:text="@string/asr_wav" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAsrCopy"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="46dp"
                android:minWidth="0dp" android:textSize="13sp" android:text="@string/copy_log" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAsr"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="46dp"
                android:layout_weight="1" android:layout_marginStart="6dp"
                android:text="@string/asr_start" />
        </LinearLayout>
    </LinearLayout>

    </LinearLayout>

    <TextView android:id="@+id/empty"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="14dp" style="@style/Label" android:lineSpacingMultiplier="1.4"
        android:text="@string/sub_empty" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:clipToPadding="false" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@color/panel"
        android:padding="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnImport"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:textSize="13sp" android:text="@string/import_srt" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnExport"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:layout_marginStart="8dp"
            android:textSize="13sp" android:text="@string/export_srt" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAdd"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:layout_marginStart="8dp"
            android:textSize="13sp" android:text="@string/add_sub" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingTop="6dp" android:paddingBottom="6dp">

    <FrameLayout android:layout_width="72dp" android:layout_height="52dp">
        <ImageView android:id="@+id/thumb"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:background="@drawable/thumb_bg"
            android:contentDescription="@string/thumb_desc" />
        <TextView android:id="@+id/ord"
            android:layout_width="19dp" android:layout_height="19dp"
            android:layout_gravity="top|start" android:layout_margin="3dp"
            android:gravity="center" android:textStyle="bold" android:textSize="11sp"
            android:textColor="@color/text" android:background="@drawable/ord_bg" />
    </FrameLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:layout_marginStart="10dp">
        <TextView android:id="@+id/name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="middle"
            android:textSize="14sp" android:textColor="@color/text" />
        <TextView android:id="@+id/meta"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/dim" />
    </LinearLayout>

    <ImageView android:id="@+id/drag"
        android:layout_width="34dp" android:layout_height="40dp"
        android:scaleType="center" android:src="@drawable/ic_drag"
        android:contentDescription="@string/drag_desc" />
    <com.google.android.material.button.MaterialButton android:id="@+id/remove"
        style="@style/IconBtn" android:layout_width="38dp" android:layout_height="40dp"
        android:text="✕" />
</LinearLayout>

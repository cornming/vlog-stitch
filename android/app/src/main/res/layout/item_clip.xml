<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingTop="7dp" android:paddingBottom="7dp">

    <TextView android:id="@+id/ord"
        android:layout_width="27dp" android:layout_height="27dp"
        android:gravity="center" android:textStyle="bold" android:textSize="13sp"
        android:textColor="@color/dim" android:background="@drawable/ord_bg" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:layout_marginStart="10dp">
        <TextView android:id="@+id/name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="middle"
            android:textSize="14sp" android:textColor="@color/text" />
        <TextView android:id="@+id/meta"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/dim" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton android:id="@+id/up"
        style="@style/IconBtn" android:layout_width="40dp" android:layout_height="40dp"
        android:text="↑" />
    <com.google.android.material.button.MaterialButton android:id="@+id/down"
        style="@style/IconBtn" android:layout_width="40dp" android:layout_height="40dp"
        android:text="↓" />
    <com.google.android.material.button.MaterialButton android:id="@+id/remove"
        style="@style/IconBtn" android:layout_width="40dp" android:layout_height="40dp"
        android:text="✕" />
</LinearLayout>

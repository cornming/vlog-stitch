<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VlogStitch" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/accent_ink</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/accent_ink</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/panel2</item>
        <item name="colorOnSurfaceVariant">@color/dim</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/panel</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">14dp</item>
    </style>

    <style name="Label">
        <item name="android:textColor">@color/dim</item>
        <item name="android:textSize">12.5sp</item>
    </style>

    <style name="IconBtn" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/dim</item>
    </style>
</resources>
